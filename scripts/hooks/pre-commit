#!/bin/sh
# Hook pre-commit : bloque tout commit contenant un secret.
echo "🔍 Gitleaks : recherche de secrets dans les fichiers à commiter..."

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ Gitleaks n'est pas installé. Installe-le avec : brew install gitleaks"
  exit 1
fi

gitleaks git --pre-commit --staged --redact -v
if [ $? -ne 0 ]; then
  echo "❌ Commit BLOQUÉ : un secret a été détecté. Retire-le avant de commiter."
  exit 1
fi

echo "✅ Aucun secret détecté."